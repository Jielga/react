{
  "name": "jielga-react",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@babel/core": "^7.29.7",
      "@mantine/code-highlight": "^9.8.2",
      "@mantine/core": "^9.8.2",
      "@mantine/hooks": "^9.8.2",
      "@mantine/spotlight": "^9.8.2",
      "@playwright/test": "^1.65.1",
      "@rolldown/plugin-babel": "^0.2.4",
      "@tabler/icons-react": "^3.53.0",
      "@tanstack/intent": "0.3.6",
      "@tanstack/match-sorter-utils": "^8.19.4",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-query": "^5.108.4",
      "@tanstack/react-store": "^0.11.4",
      "@tanstack/react-table": "^9.3.1",
      "@tanstack/react-virtual": "^3.14.28",
      "@tanstack/store": "^0.11.3",
      "@tanstack/table-core": "^9.3.1",
      "@testing-library/jest-dom": "^8.0.0",
      "@testing-library/react": "^16.3.3",
      "@testing-library/user-event": "^14.6.13",
      "@types/babel__core": "^7.20.5",
      "@types/react": "^19.3.1",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "babel-plugin-react-compiler": "^1.0.0",
      "exceljs": "^4.4.0",
      "jsdom": "^31.0.1",
      "jsurl2": "^2.2.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "react-resizable-panels": "^4.24.2",
      "typescript": "~7.0.2",
      "vite": "^8.3.8",
      "vitest": "^5.1.1",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:grid": "bun run --filter tmdatagrid-docs dev",
    "dev:popup": "bun run --filter react-popup-window-docs dev",
    "dev:map": "bun run --filter nordic-map-docs dev",
    "dev:home": "bun run --filter docs-home dev",
    "gallery": "bun run --filter @jielga/tmdatagrid gallery",
    "build": "bun run build:lib && bun run build:docs",
    "build:lib": "node scripts/run-workspaces.mjs build packages",
    "build:docs": "node scripts/run-workspaces.mjs build apps",
    "lint": "oxlint",
    "format": "prettier --write --end-of-line auto --log-level warn .",
    "format:check": "prettier --check --end-of-line auto .",
    "typecheck": "tsc -b",
    "check:skills": "node scripts/intent.mjs validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill-version.mjs && bun install --lockfile-only",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@manypkg/get-packages": "^3.1.0",
    "@playwright/test": "catalog:",
    "@tanstack/intent": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "^24.13.6",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
